data-li-identifier="-" data-name="-"><article class="listArticle" id="kapittel-1-ledd-1-punkt-2"><article class="legalP" id="kapittel-1-ledd-1-punkt-2-ledd-1"><a href="lov/2000-11-24-82/§53">§ 53</a> (tilsyn), jf. kgl.res. 29. august 2025</article></article></li><li data-li-identifier="-" data-name="-"><article class="listArticle" id="kapittel-1-ledd-1-punkt-3"><article class="legalP" id="kapittel-1-ledd-1-punkt-3-ledd-1"><a href="lov/2000-11-24-82/§55">§ 55</a> (kreve opplysninger og tilgang til områder), jf. kgl.res. 29. august 2025</article></article></li><li data-li-identifier="-" data-name="-"><article class="listArticle" id="kapittel-1-ledd-1-punkt-4"><article class="legalP" id="kapittel-1-ledd-1-punkt-4-ledd-1"><a href="lov/2000-11-24-82/§59/ledd/1">§ 59 første ledd</a> (retting), jf. kgl.res. 29. august 2025</article></article></li><li data-li-identifier="-" data-name="-"><article class="listArticle" id="kapittel-1-ledd-1-punkt-5"><article class="legalP" id="kapittel-1-ledd-1-punkt-5-ledd-1"><a href="lov/2000-11-24-82/§60">§ 60</a> (tvangsmulkt), jf. kgl.res. 29. august 2025</article></article></li><li data-li-identifier="-" data-name="-"><article class="listArticle" id="kapittel-1-ledd-1-punkt-6"><article class="legalP" id="kapittel-1-ledd-1-punkt-6-ledd-1"><a href="lov/2000-11-24-82/§60a">§ 60a</a> (overtredelsesgebyr), jf. kgl.res. 29. august 2025</article></article></li><li data-li-identifier="-" data-name="-"><article class="listArticle" id="kapittel-1-ledd-1-punkt-7"><article class="legalP" id="kapittel-1-ledd-1-punkt-7-ledd-1"><a href="lov/2000-11-24-82/§60b">§ 60b</a> (administrativ inndragelse av utbytte), jf. kgl.res. 29. august 2025.</article></article></li></ul></article></section><section class="section" data-name="kapII" id="kapittel-2" data-lovdata-URL="DEL/forskrift/2025-12-05-2429/KAPITTEL_2"><h2 data-text-align="center">II</h2><article class="legalP" id="kapittel-2-ledd-1">Vedtaket trer i kraft 1. januar 2026.</article></section></main></bo